# ===== RAILWAY ENVIRONMENT VARIABLES =====
# انسخ هذه المتغيرات في Railway → Variables

# السيرفر
PORT=3000
NODE_ENV=production

# قاعدة البيانات (Railway يعطيك هذا تلقائياً)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# JWT Secret - اكتب كلمة سرية طويلة وعشوائية
JWT_SECRET=your-super-secret-jwt-key-change-this-to-something-random-and-long

# Gmail SMTP
# 1. روح Google Account → Security → 2-Step Verification → App Passwords
# 2. اختر "Mail" و "Other (طقّه والحقّه)"
# 3. انسخ الـ 16-character password هنا
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# رابط الفرونتند (اختياري)
FRONTEND_URL=https://your-frontend-url.com
